# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# OpenAI (server-side only; add your own key locally)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL with pgvector
POSTGRES_DB=nexusflow
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://nexusflow:change-me-locally@localhost:5432/nexusflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend development origin
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-server-secret
AUTH_TOKEN_TTL=86400
