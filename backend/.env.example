APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Server-side only. Never put this value in frontend/.env files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL + pgvector (recommended)
DATABASE_URL=postgresql+asyncpg://nexusflow:change-me-locally@127.0.0.1:5432/nexusflow
MEMORY_ENABLED=true
DEVELOPMENT_SESSION_ID=development-session
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=105

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-server-secret
AUTH_TOKEN_TTL=86400

